// AAF CareConnect™ — PostgreSQL Schema
// Foundation models only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum OrganizationType {
  INDEPENDENT_FOSTERING_AGENCY
  LOCAL_AUTHORITY
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

enum UserStatus {
  PENDING_APPROVAL
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
  PHONE_VERIFICATION
}

enum AuditEventType {
  ACCOUNT_CREATED
  LOGIN_SUCCESS
  LOGIN_FAILED
  OTP_SENT
  OTP_VERIFIED
  PASSWORD_RESET_REQUEST
  PASSWORD_CHANGED
  EMAIL_VERIFIED
  SOCIAL_LOGIN
  ACCOUNT_LOCKED
  LOGOUT
  LOGOUT_ALL
  SESSION_CREATED
  SESSION_REFRESHED
  SESSION_REVOKED
  SESSION_ROTATED
  SESSION_EXPIRED
  TOKEN_REUSE_DETECTED
}

enum SessionPlatform {
  WEB
  IOS
  ANDROID
  UNKNOWN
}

enum SessionRevokedReason {
  ROTATED
  LOGOUT
  LOGOUT_ALL
  REUSE_DETECTED
  ADMIN_REVOKED
  EXPIRED
}

enum CourseLevel {
  FOUNDATION
  INTERMEDIATE
  ADVANCED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SectionType {
  VIDEO
  DOCUMENT
  RICH_TEXT
  QUIZ
}

// ─── ORGANIZATIONS ────────────────────────────────────────────────────────────

model Organization {
  id              String             @id @default(uuid())
  name            String
  type            OrganizationType
  logo_url        String?
  address         String?
  phone           String?
  email           String?
  website         String?
  ofsted_number   String?
  enabled_modules String[]           @default([])
  status          OrganizationStatus @default(TRIAL)
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt
  deleted_at      DateTime?

  users      User[]
  roles      Role[]
  courses    Course[]
  audit_logs AuditLog[]

  @@map("organizations")
}

// ─── USERS ────────────────────────────────────────────────────────────────────

model User {
  id              String     @id @default(uuid())
  firebase_uid    String     @unique
  email           String     @unique
  full_name       String?
  phone           String?
  avatar_url      String?
  organization_id String
  status          UserStatus @default(PENDING_APPROVAL)
  session_version Int        @default(1)
  last_login_at   DateTime?
  email_verified  Boolean    @default(false)
  approved_by     String?
  approved_at     DateTime?
  rejection_reason String?
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt
  deleted_at      DateTime?

  organization               Organization        @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  approver                   User?               @relation("UserApprovals", fields: [approved_by], references: [id])
  approved_users             User[]              @relation("UserApprovals")
  user_roles                 UserRole[]
  user_permissions           UserPermission[]
  verification_tokens        VerificationToken[]
  user_sessions              UserSession[]
  audit_logs                 AuditLog[]
  course_enrolments          CourseEnrolment[]
  compliance_assigned        ComplianceRecord[]  @relation("ComplianceAssignedTo")
  compliance_as_carer        ComplianceRecord[]  @relation("ComplianceCarer")
  cpd_certificates           CPDCertificate[]
  foster_carer_profile       FosterCarer?
  workforce_member_profile   WorkforceMember?
  supervised_carers          FosterCarer[]       @relation("SSWCarers")
  placements_as_ssw          Placement[]

  @@index([organization_id])
  @@index([organization_id, status])
  @@index([organization_id, created_at(sort: Desc)])
  @@map("users")
}

// ─── ROLES & PERMISSIONS ──────────────────────────────────────────────────────

model Role {
  id              String   @id @default(uuid())
  organization_id String
  name            String
  description     String?
  is_system       Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization Organization     @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  user_roles   UserRole[]
  permissions  RolePermission[]

  @@unique([organization_id, name])
  @@index([organization_id])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  resource    String // e.g. "courses", "compliance_records", "users"
  action      String // e.g. "create", "read", "update", "delete", "manage"
  description String?
  created_at  DateTime @default(now())

  role_permissions RolePermission[]
  user_permissions UserPermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  role_id       String
  permission_id String

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

model UserRole {
  user_id String
  role_id String

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
  @@map("user_roles")
}

model UserPermission {
  user_id       String
  permission_id String

  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([user_id, permission_id])
  @@map("user_permissions")
}

// ─── COURSES ──────────────────────────────────────────────────────────────────

model Course {
  id                  String       @id @default(uuid())
  organization_id     String
  title               String
  description         String?
  category            String
  level               CourseLevel  @default(FOUNDATION)
  duration_minutes    Int?
  thumbnail_url       String?
  pass_mark           Int?
  certificate_enabled Boolean      @default(true)
  status              CourseStatus @default(DRAFT)
  mandatory           Boolean      @default(false)
  target_roles        String[]     @default([])
  sort_order          Int          @default(0)
  created_at          DateTime     @default(now())
  updated_at          DateTime     @updatedAt
  deleted_at          DateTime?
  created_by          String?
  updated_by          String?

  organization Organization      @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  sections     CourseSection[]
  enrolments   CourseEnrolment[]

  @@index([organization_id])
  @@index([organization_id, status])
  @@index([organization_id, category])
  @@map("courses")
}

// ─── COURSE SECTIONS (ordered lessons) ────────────────────────────────────────

model CourseSection {
  id              String      @id @default(uuid())
  organization_id String
  course_id       String
  title           String
  type            SectionType
  sort_order      Int         @default(0)
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  course            Course           @relation(fields: [course_id], references: [id], onDelete: Cascade)
  videos            Video[]
  documents         Document[]
  rich_text_lessons RichTextLesson[]
  quizzes           Quiz[]

  @@index([organization_id])
  @@index([course_id])
  @@index([course_id, sort_order])
  @@map("course_sections")
}

// ─── VIDEOS ───────────────────────────────────────────────────────────────────

model Video {
  id              String   @id @default(uuid())
  organization_id String
  section_id      String
  title           String
  s3_key          String
  cloudfront_url  String?
  duration_secs   Int?
  thumbnail_url   String?
  transcript      String?
  sort_order      Int      @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  section CourseSection @relation(fields: [section_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@index([section_id])
  @@map("videos")
}

// ─── DOCUMENTS ────────────────────────────────────────────────────────────────

model Document {
  id              String   @id @default(uuid())
  organization_id String
  section_id      String
  title           String
  s3_key          String
  file_type       String // PDF, DOCX, etc.
  file_size       Int?
  sort_order      Int      @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  section CourseSection @relation(fields: [section_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@index([section_id])
  @@map("documents")
}

// ─── RICH TEXT LESSONS ────────────────────────────────────────────────────────

model RichTextLesson {
  id              String   @id @default(uuid())
  organization_id String
  section_id      String
  title           String
  content         Json // HTML or structured JSON content
  sort_order      Int      @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  section CourseSection @relation(fields: [section_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@index([section_id])
  @@map("rich_text_lessons")
}

// ─── QUIZZES ──────────────────────────────────────────────────────────────────

model Quiz {
  id              String   @id @default(uuid())
  organization_id String
  section_id      String
  title           String
  pass_mark       Int      @default(80)
  time_limit      Int? // minutes
  sort_order      Int      @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  section   CourseSection  @relation(fields: [section_id], references: [id], onDelete: Cascade)
  questions QuizQuestion[]

  @@index([organization_id])
  @@index([section_id])
  @@map("quizzes")
}

model QuizQuestion {
  id              String   @id @default(uuid())
  organization_id String
  quiz_id         String
  question        String
  explanation     String?
  sort_order      Int      @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  quiz    Quiz         @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@index([organization_id])
  @@index([quiz_id])
  @@map("quiz_questions")
}

model QuizAnswer {
  id              String  @id @default(uuid())
  organization_id String
  question_id     String
  text            String
  is_correct      Boolean @default(false)
  sort_order      Int     @default(0)

  question QuizQuestion @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@index([question_id])
  @@map("quiz_answers")
}

// ─── AUTHENTICATION & SECURITY ────────────────────────────────────────────────

model VerificationToken {
  id           String                @id @default(uuid())
  user_id      String?
  email        String
  type         VerificationTokenType
  hashed_token String
  expires_at   DateTime
  attempts     Int                   @default(0)
  consumed_at  DateTime?
  created_at   DateTime              @default(now())
  ip_address   String?
  user_agent   String?

  user User? @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([email, type])
  @@index([expires_at])
  @@map("verification_tokens")
}

model UserSession {
  id                 String               @id @default(uuid())
  user_id            String
  family_id          String               // Ties rotated sessions together
  parent_session_id  String?              // Previous session in the chain
  refresh_token_hash String               @unique
  platform           SessionPlatform      @default(WEB)
  device_name        String?
  browser            String?
  operating_system   String?
  ip_address         String?
  country            String?
  city               String?
  created_at         DateTime             @default(now())
  last_used_at       DateTime             @default(now())
  last_seen_at       DateTime             @default(now())
  expires_at         DateTime
  revoked_at         DateTime?
  revoked_reason     SessionRevokedReason?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("user_sessions")
}

model AuditLog {
  id              String         @id @default(uuid())
  organization_id String?
  user_id         String?
  event_type      AuditEventType
  description     String?
  ip_address      String?
  user_agent      String?
  metadata        Json?
  created_at      DateTime       @default(now())

  organization Organization? @relation(fields: [organization_id], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([organization_id])
  @@index([user_id])
  @@index([event_type])
  @@map("audit_logs")
}

// ─── COURSE ENROLMENTS ────────────────────────────────────────────────────────

enum EnrolmentStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
  FAILED
}

model CourseEnrolment {
  id               String           @id @default(uuid())
  organization_id  String
  course_id        String
  user_id          String
  status           EnrolmentStatus  @default(ENROLLED)
  progress_percent Int              @default(0)
  score            Int?
  enrolled_date    DateTime         @default(now())
  completed_date   DateTime?
  certificate_url  String?
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt

  course Course @relation(fields: [course_id], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([course_id, user_id])
  @@index([organization_id])
  @@index([user_id])
  @@index([status])
  @@map("course_enrolments")
}

// ─── COMPLIANCE RECORDS ───────────────────────────────────────────────────────

enum ComplianceType {
  ALLEGATION
  COMPLAINT
  SAFER_CARING
  MISSING_FROM_CARE
  REG_44
  AUDIT
  POLICY
}

enum ComplianceStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

enum CompliancePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model ComplianceRecord {
  id              String             @id @default(uuid())
  organization_id String
  type            ComplianceType
  title           String
  description     String?
  assigned_to_id  String?
  carer_id        String?
  child_name      String?
  incident_date   DateTime?
  due_date        DateTime?
  status          ComplianceStatus   @default(OPEN)
  priority        CompliancePriority @default(MEDIUM)
  outcome         String?
  documents       String[]           @default([])
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt

  assigned_to User? @relation("ComplianceAssignedTo", fields: [assigned_to_id], references: [id], onDelete: SetNull)
  carer       User? @relation("ComplianceCarer", fields: [carer_id], references: [id], onDelete: SetNull)

  @@index([organization_id])
  @@index([status])
  @@index([priority])
  @@index([type])
  @@map("compliance_records")
}

// ─── CPD CERTIFICATES ─────────────────────────────────────────────────────────

enum CertificateStatus {
  VALID
  EXPIRING_SOON
  EXPIRED
}

model CPDCertificate {
  id              String            @id @default(uuid())
  organization_id String
  user_id         String
  title           String
  provider        String?
  issue_date      DateTime
  expiry_date     DateTime?
  certificate_url String?
  cpd_hours       Float?
  category        String?
  status          CertificateStatus @default(VALID)
  verified        Boolean           @default(false)
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@index([user_id])
  @@index([status])
  @@map("cpd_certificates")
}

// ─── FOSTER CARERS ────────────────────────────────────────────────────────────

enum TrainingCompliance {
  COMPLIANT
  PARTIAL
  NON_COMPLIANT
}

enum CarerStatus {
  ACTIVE
  INACTIVE
  DEREGISTERED
  UNDER_REVIEW
}

model FosterCarer {
  id                   String              @id @default(uuid())
  organization_id      String
  user_id              String?             @unique
  full_name            String
  email                String
  phone                String?
  ssw_id               String?
  address              String?
  approval_date        DateTime?
  approval_category    String?
  max_placements       Int?
  current_placements   Int                 @default(0)
  annual_review_due    DateTime?
  training_compliance  TrainingCompliance  @default(PARTIAL)
  status               CarerStatus         @default(ACTIVE)
  profile_photo_url    String?
  created_at           DateTime            @default(now())
  updated_at           DateTime            @updatedAt

  user             User?       @relation(fields: [user_id], references: [id], onDelete: SetNull)
  supervising_ssw  User?       @relation("SSWCarers", fields: [ssw_id], references: [id], onDelete: SetNull)
  placements       Placement[]

  @@index([organization_id])
  @@index([status])
  @@index([email])
  @@map("foster_carers")
}

// ─── WORKFORCE MEMBERS ────────────────────────────────────────────────────────

enum RoleType {
  SUPERVISING_SOCIAL_WORKER
  INDEPENDENT_ASSESSOR
  PANEL_MEMBER
  TRAINER
  MANAGER
  ADMINISTRATOR
}

enum EmploymentType {
  EMPLOYED
  SELF_EMPLOYED
  CONTRACTOR
}

enum WorkforceStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

model WorkforceMember {
  id              String          @id @default(uuid())
  organization_id String
  user_id         String?         @unique
  full_name       String
  email           String
  phone           String?
  role_type       RoleType
  employment_type EmploymentType?
  dbs_number      String?
  dbs_expiry      DateTime?
  contract_url    String?
  availability    String?
  status          WorkforceStatus @default(ACTIVE)
  caseload_count  Int             @default(0)
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([organization_id])
  @@index([status])
  @@index([role_type])
  @@map("workforce_members")
}

// ─── PLACEMENTS ───────────────────────────────────────────────────────────────

enum PlacementType {
  EMERGENCY
  SHORT_TERM
  LONG_TERM
  RESPITE
  PARENT_CHILD
}

enum PlacementStatus {
  REFERRAL
  MATCHING
  ACTIVE
  ENDED
  BREAKDOWN
}

model Placement {
  id                 String          @id @default(uuid())
  organization_id    String
  child_name         String
  child_dob          DateTime?
  carer_id           String
  ssw_id             String?
  referral_source    String?
  placement_start    DateTime?
  placement_end      DateTime?
  placement_type     PlacementType
  status             PlacementStatus @default(REFERRAL)
  notes              String?
  needs_description  String?
  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt

  carer FosterCarer @relation(fields: [carer_id], references: [id], onDelete: Cascade)
  ssw   User?       @relation(fields: [ssw_id], references: [id], onDelete: SetNull)

  @@index([organization_id])
  @@index([carer_id])
  @@index([status])
  @@map("placements")
}

{
  "name": "RecruitmentLead",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "organisation_id": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "website",
        "referral",
        "social_media",
        "event",
        "word_of_mouth",
        "other"
      ]
    },
    "pipeline_stage": {
      "type": "string",
      "enum": [
        "new_enquiry",
        "initial_contact",
        "information_sent",
        "home_visit_booked",
        "application_started",
        "form_f_initiated",
        "converted",
        "rejected",
        "withdrawn"
      ],
      "default": "new_enquiry"
    },
    "assigned_to_id": {
      "type": "string"
    },
    "enquiry_date": {
      "type": "string",
      "format": "date"
    },
    "next_followup_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "full_name",
    "email"
  ]
}
{
  "name": "CPDCertificate",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "organisation_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "certificate_url": {
      "type": "string"
    },
    "cpd_hours": {
      "type": "number"
    },
    "category": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "valid",
        "expiring_soon",
        "expired"
      ],
      "default": "valid"
    },
    "verified": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id",
    "title",
    "issue_date"
  ]
}
{
  "name": "FosterCarer",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "organisation_id": {
      "type": "string"
    },
    "ssw_id": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "approval_date": {
      "type": "string",
      "format": "date"
    },
    "approval_category": {
      "type": "string"
    },
    "max_placements": {
      "type": "number"
    },
    "current_placements": {
      "type": "number",
      "default": 0
    },
    "annual_review_due": {
      "type": "string",
      "format": "date"
    },
    "training_compliance": {
      "type": "string",
      "enum": [
        "compliant",
        "partial",
        "non_compliant"
      ],
      "default": "partial"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "deregistered",
        "under_review"
      ],
      "default": "active"
    },
    "profile_photo_url": {
      "type": "string"
    }
  },
  "required": [
    "full_name",
    "email"
  ]
}
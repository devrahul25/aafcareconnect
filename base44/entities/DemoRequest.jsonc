{
  "name": "DemoRequest",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "organisation": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "org_type": {
      "type": "string",
      "enum": [
        "Independent Fostering Agency",
        "Local Authority",
        "Other"
      ]
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "demo_booked",
        "converted"
      ],
      "default": "new"
    }
  },
  "required": [
    "full_name",
    "email",
    "organisation",
    "role"
  ]
}